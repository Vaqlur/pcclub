# Copy to backend/.env and fill in. .env is gitignored — never commit real values.

ENVIRONMENT=dev

# PostgreSQL (asyncpg driver). Replace USER/PASSWORD with your local role.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/pcclub
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/pcclub_test

# Secrets. Dev defaults exist in code; ENVIRONMENT=prod refuses to start without real values.
# JWT_SECRET=            python -c "import secrets; print(secrets.token_urlsafe(48))"
# IIN_HASH_PEPPER=       python -c "import secrets; print(secrets.token_urlsafe(48))"
# IIN_ENCRYPTION_KEY=    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Integrations: only "mock" exists in phase 1.
IDENTITY_PROVIDER=mock
SMS_PROVIDER=mock
PAYMENT_PROVIDER_CARD=mock
PAYMENT_PROVIDER_KASPI=mock

# CORS (browsers only: Expo web preview, admin panel). Unset = http://localhost:* in dev,
# disabled in test and prod. Set a regex of allowed origins to override, or empty to disable.
# CORS_ALLOW_ORIGIN_REGEX=^https://admin\.example\.kz$

# Mock SMS: every login code is this value in dev. Leave empty for random codes (logged).
OTP_FIXED_CODE=000000
